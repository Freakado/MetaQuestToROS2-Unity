# This file is for ignoring Unity-specific generated files and folders.
# This is a standard template for Unity projects.

# Unity-generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
.utmp/

# MemoryCaptures can get huge
/[Mm]emoryCaptures/

# Asset Store folder - contents should be downloaded by each user
/[Aa]ssets/AssetStoreTools*

# VS Code specific files
.vscode/

# Visual Studio specific files
.vs/
*.csproj
*.sln
*.suo
*.user
*.userprefs

# JetBrains Rider specific files
.idea/
*.sln.DotSettings.user

# Mac specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Build results
*.apk
*.aab

# Crashlytics generated folder
/[Cc]rashlytics/

# Autogenerated files from some plugins
/[Aa]ssets/Plugins/Editor/JetBrains*